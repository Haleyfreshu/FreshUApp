# Supabase — from Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — from developers.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI (local dev) or your webhook endpoint's signing secret (production)
STRIPE_WEBHOOK_SECRET=

# Base URL used to build Stripe success/cancel redirect links.
# Local dev: http://localhost:3000  |  Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
